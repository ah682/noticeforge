# Local-only demonstration. No credentials or external calls are required.
NOTICEFORGE_DATA_DIR=./var
NOTICEFORGE_HOST=127.0.0.1
NOTICEFORGE_PORT=8877
# Loopback hosts are allowed by default. A private reverse proxy needs its exact hostname.
# This is Host validation, not authentication; never use * to expose the local app.
# NOTICEFORGE_ALLOWED_HOSTS=notices.example.com
NOTICEFORGE_MAX_BYTES=10485760
NOTICEFORGE_MAX_PAGES=100
# OCR is optional. Install Tesseract and set its tessdata directory to enable it.
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# Model providers are opt-in; see docs/MODELS.md and configs/.
# NOTICEFORGE_PROVIDER=fixture
# Fixture mode is explicitly offline; this path supplies owned test output JSON.
# NOTICEFORGE_FIXTURE_OUTPUT_PATH=/path/to/owned-fixture-proposals.json
# NOTICEFORGE_PROVIDER=transformers
# NOTICEFORGE_MODEL_CONFIG=configs/compact-lora.json
# Generation is explicit from the Model review tab; uploads always use rules first.
# Cached pretrained weights and the optional ML environment are required for local model review.
# NOTICEFORGE_PROVIDER=compatible
# NOTICEFORGE_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# NOTICEFORGE_MODEL_ID=your-served-model
# NOTICEFORGE_MODEL_TIMEOUT=30  # per-attempt seconds, greater than 0 and at most 300
# NOTICEFORGE_MODEL_TOKEN=
# Set only after authorizing transfer to a configured nonlocal service:
# NOTICEFORGE_ALLOW_REMOTE=1
