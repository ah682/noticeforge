          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--E-Mail-->
      <xsd:element name="pcnPersEmail" type="emailType" minOccurs="0" maxOccurs="1"/>

      <!--Phone Number-->
      <xsd:element name="persPhone" minOccurs="0" maxOccurs="unbounded">
