        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:pattern value="[0-9]{9}"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Business Unit-->
      <xsd:element name="pcnBusinessUnit" minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Company-->
      <xsd:element name="pcnCompany" minOccurs="1" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--E-Mail-->
      <xsd:element name="pcnEmail" type="emailType" minOccurs="1" maxOccurs="1"/>

      <!--Contact Link-->
      <xsd:element name="contactLink"  minOccurs="0" maxOccurs="1">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="pcnContactUrl" type="xsd:anyURI" minOccurs="1" maxOccurs="1"/>

            <!--Username-->
            <xsd:element name="pcnContactUsername" minOccurs="0" maxOccurs="1">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="128"/>
                  <xsd:whiteSpace value="replace"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>

            <!--Password-->
            <xsd:element name="pcnContactPassword" minOccurs="0" maxOccurs="1">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="128"/>
                  <xsd:whiteSpace value="replace"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!--Address-->
      <xsd:element name="address" type="addressType" minOccurs="1" maxOccurs="1"/>

      <!--Phone Number-->
      <xsd:element name="phone" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:attribute name="pcnPhoneNumber" type="PhoneNumber" use="required" />
          <xsd:attribute name="pcnPhoneType" type ="PhoneType" use="required"/>
        </xsd:complexType>
      </xsd:element>   

        <!--ContactPersons-->
      <xsd:element name="persons" minOccurs="0" maxOccurs="1">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="person" type="personType" minOccurs="1" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>

    <!--Contact-Type-->
    <xsd:attribute name="pcnContactType" use="required">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="MANUFACTURER"/>
		  <xsd:enumeration value="Manufacturer"/>
          <xsd:enumeration value="DISTRIBUTOR"/>
          <xsd:enumeration value="Distributor"/>
		  <xsd:enumeration value="CUSTOMER"/>
		  <xsd:enumeration value="Customer"/>
		  <xsd:enumeration value="DATASERVICEPROVIDER"/>
		  <xsd:enumeration value="DataServiceProvider"/>
          <xsd:enumeration value="SERVICEPROVIDER"/>
          <xsd:enumeration value="Serviceprovider"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
  </xsd:complexType>
  <!--End contact-->
  
  <!--Data type for an E-Mail-Address-->
  <xsd:simpleType name="emailType">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="256"/>
      <xsd:pattern value="([a-zA-Z0-9_\-])([a-zA-Z0-9_\-\.]*)@(\[((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}|((([a-zA-Z0-9\-]+)\.)+))([a-zA-Z]{2,}|(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\])"/>
    </xsd:restriction>
  </xsd:simpleType>
  <!--emailType end-->

  <!--Data type for Phonenumber-->
  <xsd:simpleType name="PhoneNumber">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="128"/>
