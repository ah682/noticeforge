<xsd:schema
    xmlns="http://www.smartpcn.org/images/files/VDMA24903Schema/PCNbody"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://www.smartpcn.org/images/files/VDMA24903Schema/PCNbody"
elementFormDefault="qualified">
<xsd:element name="PCNbody">
    <xsd:complexType>
      <xsd:sequence>
        <!--Cluster Masterdata-->
        <xsd:element name="masterData" maxOccurs="1" minOccurs="1">
          <xsd:complexType>
            <xsd:sequence>

              <!--PCN-Number-->
              <xsd:element name="pcnNumber" minOccurs="1" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="128"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

               <!--Title-->
              <xsd:element name="pcnTitle" minOccurs="1" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="256"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              
              <!--Alert-Type: Major - Minor-->
              <xsd:element name="pcnAlertType" type="alertType" minOccurs="0" maxOccurs="1"/>
              
              <!--PCN-Type-->
              <xsd:element name="pcnType" type="pcnType" minOccurs="1" maxOccurs="1"/>

              
              <!--Manufacturer High level name-->
              <xsd:element name="pcnMfrName" minOccurs="1" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="32"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              
               <!--Impact Description-->
              <xsd:element name="pcnAlertImpact" minOccurs="0" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="4096"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              
               <!--Product Category-->
              <xsd:element name="pcnProductCategory" type="productCategoryType" minOccurs="0" maxOccurs="1"/>

              <!--Issue Date-->
              <xsd:element name="pcnIssueDate" type="xsd:date" minOccurs="1" maxOccurs="1"/>

              <!--optional Blank-->
              <xsd:element name="pcnAddInfo" minOccurs="0" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="1024"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

              <xsd:element name="pcnRevision" minOccurs="0" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value = "32"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

              <!--PCN Link-->
              <xsd:element name="pcnLink"  minOccurs="0" maxOccurs="1">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="pcnUrl" type="xsd:anyURI" minOccurs="1" maxOccurs="1"/>

                    <!--Username-->
                    <xsd:element name="pcnUserName" minOccurs="0" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="128"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>

                    <!--Password-->
                    <xsd:element name="pcnPassword" minOccurs="0" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="128"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>

              <!--Revisions-->
              <xsd:element name="revisions" minOccurs="0" maxOccurs="1">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="revision" type="revisionType" minOccurs="1" maxOccurs="unbounded" />
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              
              <!--Contacts-->
              <xsd:element name="contacts" minOccurs="1" maxOccurs="1">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="contact" type="contactType" minOccurs="1" maxOccurs="unbounded"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>

           <!--SmartPCN Format Version   Beipiel: VDMA24903_1.0-->
              <xsd:attribute name="pcnFormatVersion" use="required">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="16"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:attribute>           
          </xsd:complexType>
        
        </xsd:element>
        <!--Masterdata Cluster End-->
        
        <!--Cluster Difference Description-->
        <xsd:element name="difference" maxOccurs="1" minOccurs="1">
          <xsd:complexType>
            <xsd:sequence>

              <!--Change Titel-->
              <xsd:element name="pcnChangeTitle" minOccurs="1" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="128"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

              <!--Change Detail-->
              <xsd:element name="pcnChangeDetail" minOccurs="1" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="4096"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

              <!--Input to customer for risk assessment process-->
              <xsd:element name="pcnRiskAssessment" minOccurs="0" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="2048"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

              <!--Intended start of delivery-->
              <xsd:element name="pcnFirstDelivery" type="xsd:date" minOccurs="0" maxOccurs="1"/>

              <!--Customer feedback required until-->
              <xsd:element name="pcnFeedbackUntil" type="xsd:date" minOccurs="0" maxOccurs="1"/>

              <!--Method identifiying changed product-->
              <xsd:element name="pcnChangeIdentificationMethod" minOccurs="0" maxOccurs="1">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="4096"/>
                    <xsd:whiteSpace value="replace"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>

              <!--Effective date-->
              <xsd:element name="pcnEffectiveDate" type="xsd:date" minOccurs="0" maxOccurs="1"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <!--Difference Description Cluster End-->

        <!--Cluster Itemnumbers-->
        <xsd:element name="ItemNumbers" maxOccurs="1" minOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="ItemNumber" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>

                    <!--Item Manufacturer Item number-->
                    <xsd:element name="itemMfrNumber" minOccurs="1" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="128"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>

                    <!--Manufacturer item Type identifier-->
                    <xsd:element name="itemMfrTypeIdent" minOccurs="0" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="128"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>

                    <!--Manufacturer item Name-->
                    <xsd:element name="itemMfrName" minOccurs="1" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="128"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>

                    <!--Manufacturer item description-->
                    <xsd:element name="itemMfrDescription" minOccurs="0" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="1024"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>

                    <!--Item form-->
                    <xsd:element name="itemFormName" minOccurs="0" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="128"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>

                    <!--Item Category-->
                    <xsd:element name="itemCategory" type="itemCategoryType" minOccurs="1" maxOccurs="1" />
                    
                    <!--Item Revision Number-->
                    <xsd:element name="itemRev" minOccurs="0" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value = "32"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>                    
                    

                    <!--Qualification-->
                    <xsd:element name="itemQualification" type="qualificationType" minOccurs="0" maxOccurs="1"/>

                    <!--End of life-->
                    <xsd:element name="itemLifeCycleData" minOccurs="1" maxOccurs="1" > <!--type="endOfLifeType"-->
                      <xsd:complexType>
                          <!--Item SOP start of production-->
                        <xsd:attribute name="itemSOP" type="xsd:date"/>

                          <!--Item EOS end of sales-->
                        <xsd:attribute name="itemEOS" type="xsd:date" />

                          <!--Item EOP end of production-->
                        <xsd:attribute name="itemEOPeffDate" type="xsd:date" use="required"/>

                          <!--Item LTD Last time delivery-->
                        <xsd:attribute name="itemLTD" type="xsd:date" />

                          <!--Item EOSR end of service and repair-->
                        <xsd:attribute name="itemEOSR" type="xsd:date" />

                          <!--Delivery Unit-->
                        <xsd:attribute name="itemLCI" >
                          <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                              <xsd:maxLength value="2"/>
                              <xsd:pattern value="[0-9]{2}"/>
                            </xsd:restriction>
                          </xsd:simpleType>
                        </xsd:attribute>
                      </xsd:complexType>
                    </xsd:element>
                    <!--endOfLifeType end-->

                    <!--Replacements-->
                    <xsd:element name="itemReplacements" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:sequence>
                          <!--Customer Partnumber-->
                          <xsd:element name="itemReplacement" type="replacementType" minOccurs="1" maxOccurs="unbounded"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>

                    <!--Customer Itemnumbers-->
                    <xsd:element name="customerItemnumbers" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:sequence>
                          <!--Customer Partnumber-->
                          <xsd:element name="customerItemnumber" type="customerItemnumberType" minOccurs="1" maxOccurs="unbounded"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>

                    <!--Item substructures-->
                    <xsd:element name="itemSubStructures" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:sequence>
                          <!--Customer Partnumber-->
                          <xsd:element name="itemSubStructure" type="SubStructureType" minOccurs="1" maxOccurs="unbounded"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    
                    <!--Item change types-->
                    <xsd:element name="itemChanges" minOccurs="1" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:sequence>
                          <!--Customer Partnumber-->
                          <xsd:element name="itemChange" type="itemChangeType" minOccurs="1" maxOccurs="unbounded"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <!--Itemnumbers Cluster End-->
        
        <!--Cluster Life Cycle Data-->
        <xsd:element name="pcnLifeCycleData" maxOccurs="1" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <!--SOP start of production-->
              <xsd:element name="pcnSOP" type="xsd:date" minOccurs="0" maxOccurs="1"/>

              <!--EOS end of sales-->
              <xsd:element name="pcnEOS" type="xsd:date" minOccurs="0" maxOccurs="1"/>

              <!--EOP end of production-->
              <xsd:element name="pcnEOPeffDate" type="xsd:date" minOccurs="1" maxOccurs="1"/>

              <!--LTD Last time delivery-->
              <xsd:element name="pcnLTD" type="xsd:date" minOccurs="0" maxOccurs="1"/>

              <!--EOSR end of service and repair-->
              <xsd:element name="pcnEOSR" type="xsd:date" minOccurs="0" maxOccurs="1"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <!--Life Cycle Data Cluster End-->
        
        <!--Cluster Causes of Changes-->
        <xsd:element name="pcnCauseOfChanges" maxOccurs="1" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>

              <!--Single Change-->
              <xsd:element name="pcnChange" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>

                    <!--Description of change-->
                    <xsd:element name="pcnChangeDescription" minOccurs="1" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="1024"/>
                          <xsd:whiteSpace value="replace"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    
                  </xsd:sequence>

                  <!--Type of Change-->
                  <xsd:attribute name="pcnChangeType" type="typeOfChangeType" use="required" />
                  
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <!--Causes of Changes Cluster End-->
        
        <!--Cluster Substructures-->
        <xsd:element name="pcnSubStructures" maxOccurs="1" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>

              <!--classificationEntry-->
              <xsd:element name="pcnSubStructure" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>

                    <!--classification data-->
                    <xsd:element name="pcnSubData" minOccurs="1" maxOccurs="1">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="4096"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>

                  <!--Type of classification-->
                  <xsd:attribute name="pcnSubType" type="SubType" use="required" />

                  <!--Revision of classification-->
                  <xsd:attribute name="pcnSubRevision" use="optional" >
                    <xsd:simpleType>
                      <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="32"/>
                        <xsd:whiteSpace value="replace"/>                        
                      </xsd:restriction>
                    </xsd:simpleType>
                  </xsd:attribute>

                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <!--Substructures Cluster End-->
      </xsd:sequence>
    </xsd:complexType>  
  </xsd:element>
  <!--PCNbody End-->

  <!--############ PCNbody data types definitions ###############-->
  <!--Datatype for Alert Type-->
  <xsd:simpleType name="alertType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="MAJOR"/>
	  <xsd:enumeration value="Major"/>
      <xsd:enumeration value="MINOR"/>
	  <xsd:enumeration value="Minor"/>
    </xsd:restriction>
  </xsd:simpleType>

  <!--Datatype for Pcn Type-->
  <xsd:simpleType name="pcnType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="PCN"/>
      <xsd:enumeration value="PDN"/>
    </xsd:restriction>
  </xsd:simpleType>

  <!--Datatype for Product Category-->
  <xsd:simpleType name="productCategoryType">    
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="ACEL"/>     <!--active electronic-->
      <xsd:enumeration value="ASSY"/>     <!--assembly-->
      <xsd:enumeration value="AUXM"/>     <!--auxiliary materials-->
      <xsd:enumeration value="CCBL"/>     <!--connectors/cables-->
      <xsd:enumeration value="DACE"/>     <!--data/certificates-->
      <xsd:enumeration value="DOCU"/>     <!--documentation-->
      <xsd:enumeration value="ELME"/>     <!--electro mechanical-->
      <xsd:enumeration value="FLUI"/>     <!--fluids-->
      <xsd:enumeration value="HYDR"/>     <!--hydraulic-->
      <xsd:enumeration value="MECH"/>     <!--mechanical-->
      <xsd:enumeration value="MULT"/>     <!--multiple categories-->
      <xsd:enumeration value="OTHR"/>     <!--others-->
      <xsd:enumeration value="PAEL"/>     <!--passive electrical/electronic-->
      <xsd:enumeration value="PNEU"/>     <!--pneumatic-->
      <xsd:enumeration value="RAWM"/>     <!--raw material-->
      <xsd:enumeration value="SERV"/>     <!--services-->
      <xsd:enumeration value="SWFW"/>     <!--software/firmware-->
    </xsd:restriction>
  </xsd:simpleType>

  <!--Datatype for item Category is identical to productCategoryType-->
  <xsd:simpleType name="itemCategoryType" >
    <xsd:restriction base="productCategoryType" />
  </xsd:simpleType>

  <xsd:simpleType name="SubType">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="32"/>
  <!--<xsd:enumeration value="ECLASS"/>   --><!-- eCl@ss--><!--
      <xsd:enumeration value="BMECAT"/>   --><!-- BMEcat--><!--
      <xsd:enumeration value="CHANGE"/>   --><!-- Change information--><!--
      <xsd:enumeration value="TEXT"/>     --><!-- Beliebiger Text--><!--
      <xsd:enumeration value="MACH"/>     --><!-- Maschinenbau--><!--
      <xsd:enumeration value="RAILWAY"/>  --><!-- Eisenbahntechnik--><!--
      <xsd:enumeration value="AVIONIK"/>  --><!-- Flugzeugtechnik--><!--
      <xsd:enumeration value="REACH"/>    --><!-- Schadstoffe--><!--
      <xsd:enumeration value="HMM"/>      --><!-- Hazareous Materials Management--><!--
      <xsd:enumeration value="CMM"/>      --><!-- Conflict Minerals Management--><!--
      <xsd:enumeration value="CHEM"/>     --><!-- Chemische Industrie--><!--
      <xsd:enumeration value="PHARM"/>    --><!-- Pharmazeutische Industrie--><!--
      <xsd:enumeration value="MEDI"/>     --><!-- Medizintechnik--><!--
      <xsd:enumeration value="AUTO"/>     --><!-- Automobiltechnik-->
    </xsd:restriction>
  </xsd:simpleType>

  <!--Data type for a Revision-->
  <xsd:complexType name="revisionType">
    <xsd:sequence>
      <!--Cause of Revision-->
      <xsd:element name="pcnRevisionCause" minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value = "2048"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>      
    
    <!--Revision Number-->
      <xsd:attribute name="pcnRevisionNumber" use="required">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value = "16"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>

      <!--Revision Date-->
      <xsd:attribute name="pcnRevDate" type="xsd:date" use="required" />
  </xsd:complexType>
  <!--revisionType end-->

  <!--Datatype for a qualification-->
  <xsd:complexType name="qualificationType">
    <xsd:sequence>

      <!--Manufacturer Qualification plan schedule and results-->
      <xsd:element name="itemQualificationSchedule" minOccurs="0" maxOccurs="1" >
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Qualification description-->
      <xsd:element name="itemQualificationDescription"  minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="1024"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Date of qualification results-->
      <xsd:element name="itemQualificationResultDate" type="xsd:date" minOccurs="0" maxOccurs="1"/>

      <!--Date qualification samples available-->
      <xsd:element name="itemQualificationSamplesDate" type="xsd:date" minOccurs="0" maxOccurs="1"/>

      <!--Date final qualification data available-->
      <xsd:element name="itemQualificationFinalDate"  type="xsd:date" minOccurs="0" maxOccurs="1"/>

      <!--Qualification report and qualification results-->
      <xsd:element name="itemQualificationReport" minOccurs="0" maxOccurs="1">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="itemQualificationReportUrl" type="xsd:anyURI" minOccurs="1" maxOccurs="1"/>

            <!--Username-->
            <xsd:element name="itemQualificationReportUsername" minOccurs="0" maxOccurs="1">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="128"/>
                  <xsd:whiteSpace value="replace"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>

            <!--Password-->
            <xsd:element name="itemQualificationReportPassword" minOccurs="0" maxOccurs="1">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="128"/>
                  <xsd:whiteSpace value="replace"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:sequence>
  </xsd:complexType>
  <!--qualificationType end-->

  <!--Type for replacement type-->
  <xsd:complexType name="replacementType">
    <xsd:sequence>
      <!--Replacement manufacturer item number-->
      <xsd:element name="itemMfrReplNumber" minOccurs="1" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Replacement manufacturer item Type identifier-->
      <xsd:element name="itemMfrReplTypeIdent" minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Replacement manufacturer item name-->
      <xsd:element name="itemMfrReplName" minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Replacement manufacturer brand name-->
      <xsd:element name="itemMfrReplBrandName" minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="128"/>
            <xsd:whiteSpace value="replace"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>

      <!--Replacement package-->
      <xsd:element name="itemMfrReplPackage" minOccurs="0" maxOccurs="1">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
