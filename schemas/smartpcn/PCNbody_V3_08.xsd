          <xsd:attribute name="pcnPersPhoneNumber" type="PhoneNumber" use="required" />
          <xsd:attribute name="pcnPersPhoneType" type ="PhoneType" use="required"/>
        </xsd:complexType>
      </xsd:element>

    </xsd:sequence>
  </xsd:complexType>
